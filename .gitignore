# Le contenu du vault (notes, PDF, documents Efrei) reste privé : on part de
# « rien », puis on réautorise la configuration Obsidian explicitement.
/*
!/.gitignore
!/.github/
!/.obsidian/
!/install.ps1
!/plugins.json
!/README.md
!/.stignore-commun

# État local, propre à une machine ou à une session : rien à partager.
/.obsidian/workspace.json
/.obsidian/workspace-mobile.json
/.obsidian/quiz-blocks-results/

# Données personnelles et identifiants. Le repo est PUBLIC : ces trois fichiers
# ne doivent jamais y entrer.
#   quiz-blocks   : journal d'usage de l'IA (sessionId, horodatages)
#   moodle-sync   : identifiants Moodle Efrei, si un data.json est créé un jour
/.obsidian/plugins/quiz-blocks/data.json
/.obsidian/plugins/moodle-sync/data.json

# Polices : à récupérer auprès de leur éditeur, pas à redistribuer ici.
/.obsidian/snippets/*.woff2

# Thème AnuPpuccin : installé depuis Obsidian, son dépôt fait foi.
/.obsidian/themes/

# Sauvegardes locales avant patch des plugins.
*.bak
